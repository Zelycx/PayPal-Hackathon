<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- BUBBLE BUTTON -->
    <Button
        android:id="@+id/bubble_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:text="@string/bubble_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.553"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/avatar_placeholder"
            android:layout_width="132dp"
            android:layout_height="180dp"
            android:contentDescription="@string/avatar_placeholder"
            android:scaleType="fitCenter"
            android:src="@drawable/avatar_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- SPEECH BUBBLE -->
        <ImageView
            android:id="@+id/speech_bubble_placeholder"
            android:layout_width="279dp"
            android:layout_height="180dp"
            android:contentDescription="@string/speech_bubble_placeholder"
            android:scaleType="fitCenter"
            android:src="@drawable/speech_bubble_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


