<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- AVATAR -->
    <ImageView
        android:id="@+id/avatar_placeholder"
        android:layout_width="132dp"
        android:layout_height="177dp"
        android:contentDescription="@string/avatar_placeholder"
        android:scaleType="fitCenter"
        android:src="@drawable/avatar_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- SPEECH BUBBLE -->
    <ImageView
        android:id="@+id/speech_bubble_placeholder"
        android:layout_width="279dp"
        android:layout_height="177dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/speech_bubble_placeholder"
        android:scaleType="fitCenter"
        android:src="@drawable/speech_bubble_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
