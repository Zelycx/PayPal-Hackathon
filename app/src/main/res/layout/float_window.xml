<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/main_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- CART -->
        <ImageView
            android:id="@+id/cart"
            android:contentDescription="@string/cart"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cart_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- SELECTOR -->
        <ImageView
            android:contentDescription="@string/selector"
            android:id="@+id/selector"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/selector_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- WALLET -->
        <ImageView
            android:contentDescription="@string/wallet"
            android:id="@+id/wallet"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:src="@drawable/wallet_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cart_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#6d9239"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="@id/main_action_bar"
        app:layout_constraintEnd_toEndOf="@id/main_action_bar"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar">

        <TextView
            android:id="@+id/cart_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- WALLET INFO BOX LAYOUT -->
    <LinearLayout
        android:id="@+id/wallet_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#8daf50"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="@id/main_action_bar"
        app:layout_constraintEnd_toEndOf="@id/main_action_bar"
        app:layout_constraintTop_toBottomOf="@id/main_action_bar">

        <!-- WALLET INFO BOX -->
        <TextView
            android:id="@+id/wallet_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/avatar_placeholder"
            android:layout_width="132dp"
            android:layout_height="180dp"
            android:contentDescription="@string/avatar_placeholder"
            android:scaleType="fitCenter"
            android:src="@drawable/avatar_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- SPEECH BUBBLE -->
        <ImageView
            android:id="@+id/speech_bubble_placeholder"
            android:layout_width="279dp"
            android:layout_height="180dp"
            android:contentDescription="@string/speech_bubble_placeholder"
            android:scaleType="fitCenter"
            android:src="@drawable/speech_bubble_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
